{"input":{"command":"sleep 20; osascript -e 'tell application \"StarPlayrX\" to detach menu' >\/dev\/null 2>&1\nfor ch in 2 26 8; do rm -f \/tmp\/spectrum.log; osascript -e 'with timeout of 40 seconds' -e \"tell application \\\"StarPlayrX\\\" to play channel \\\"$ch\\\"\" -e 'end timeout' >\/dev\/null; sleep 40\necho \"== ch $ch: hit=$(grep -c ' hit' \/tmp\/spectrum.log) miss=$(grep -c ' miss' \/tmp\/spectrum.log) nolive=$(grep -c nolive \/tmp\/spectrum.log) segs=$(grep -c ' seg ' \/tmp\/spectrum.log)\"\nawk '$5==\"hit\"||$5==\"miss\"{print $2,$5}' \/tmp\/spectrum.log | uniq -c | awk '{printf \"%s %s x%s | \", $2,$3,$1} END{print \"\"}'; done"},"tool":"user_shell","spilled":1793633236.1232738}