{"spilled":1793633236.171165,"tool":"file","input":{"action":"diff_apply","destination":"\/\/\/ A couple of small, round bubbles rising through a bar, half a cycle apart (some bars get just one).\n\/\/\/ Each has its own size and is soft-edged, swaying gently and fading in at the bottom and out at the top.\nprivate struct LavaBubbles: View {\n    let rise: Double\n    let seed: Double\n    let color: Color\n\n    var body: some View {\n        Canvas { ctx, size in\n            guard size.height > 8 else { return }\n            for k in 0..<2 {\n                \/\/ Every third bar gets one bubble only, so the row isn't uniformly busy.\n                if k == 1, Int(seed) % 3 == 0 { continue }\n                let p = (rise + Double(k) \/ 2 + seed * 0.137).truncatingRemainder(dividingBy: 1)\n                \/\/ Each bubble's size is fixed per bar and slot (so it never flickers): 30...80% of the bar's\n                \/\/ width, swelling a little as it rises, like warm wax.\n                let r = abs(sin(seed * 12.9898 + Double(k) * 78.233) * 43758.5453).truncatingRemainder(dividingBy: 1)\n                let d = min(size.width * (0.3 + 0.5 * r), size.height * 0.35) * (0.85 + 0.3 * p)\n                let x = size.width \/ 2 + size.width * 0.1 * sin(p * 6 + seed * 2)\n                let y = size.height + d \/ 2 - (size.height + d) * p           \/\/ in from the bottom, out the top\n                let fade = min(1, sin(p * .pi) * 2)\n                let rect = CGRect(x: x - d \/ 2, y: y - d \/ 2, width: d, height: d)\n                \/\/ Soft: fades from a gentle centre to nothing at the edge, with no hard rim or highlight.\n                ctx.fill(Path(ellipseIn: rect), with: .radialGradient(\n                    Gradient(colors: [color.opacity(0.3 * fade), color.opacity(0.14 * fade), color.opacity(0)]),\n                    center: CGPoint(x: rect.midX - d * 0.1, y: rect.midY - d * 0.1), startRadius: 0, endRadius: d * 0.6))\n            }\n        }\n        .allowsHitTesting(false)\n    }\n}","start_line":236,"end_line":263,"file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Visualizer.swift"}}