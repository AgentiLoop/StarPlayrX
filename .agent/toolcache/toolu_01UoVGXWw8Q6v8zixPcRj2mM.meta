{"input":{"file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Xtra.swift","new_string":"    \/\/\/ EXPERIMENT: a live (channel-linear) channel tuned through the modern API, the way the web player does.\n    \/\/\/ Returns the signed master playlist (AES-128 HLS, ~5 h DVR) and the bearer its key URI needs.\n    func liveStream(channelID: String) async throws -> (url: URL, bearer: String) {\n        let auth = try await bearer()\n        let tune = try await json(\"POST\", \"\/playback\/play\/v1\/tuneSource\",\n                                  body: [\"id\": channelID, \"type\": \"channel-linear\", \"hlsVersion\": \"V3\",\n                                         \"manifestVariant\": \"WEB\", \"mtcVersion\": \"V2\"],\n                                  bearer: auth)\n        let urls = (tune[\"streams\"] as? [[String: Any]])?.first?[\"urls\"] as? [[String: Any]] ?? []\n        guard let s = (urls.first { $0[\"isPrimary\"] as? Bool == true } ?? urls.first)?[\"url\"] as? String,\n              let url = URL(string: s) else { throw XtraError.badResponse(\"live stream url\") }\n        return (url, auth)\n    }","old_string":"    \/\/\/ EXPERIMENT: tune a live (channel-linear) channel through the modern API and dump the raw response.\n    func probeLinear(channelID: String) async {\n        do {\n            let tune = try await json(\"POST\", \"\/playback\/play\/v1\/tuneSource\",\n                                      body: [\"id\": channelID, \"type\": \"channel-linear\", \"hlsVersion\": \"V3\",\n                                             \"manifestVariant\": \"WEB\", \"mtcVersion\": \"V2\"],\n                                      bearer: try await bearer())\n            let data = try JSONSerialization.data(withJSONObject: tune, options: [.prettyPrinted, .withoutEscapingSlashes])\n            try data.write(to: URL(fileURLWithPath: \"\/tmp\/spx-linear-probe.json\"))\n        } catch {\n            try? \"\\(error)\".write(toFile: \"\/tmp\/spx-linear-probe.json\", atomically: true, encoding: .utf8)\n        }\n    }","action":"edit"},"spilled":1793644968.7283468,"tool":"edit_file"}