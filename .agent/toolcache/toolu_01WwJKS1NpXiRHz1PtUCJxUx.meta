{"tool":"edit_file","input":{"old_string":"    \/\/\/ The track an Xtra channel would start with if tuned now, without downloading anything.","file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Xtra.swift","action":"edit","new_string":"    \/\/\/ EXPERIMENT: tune a live (channel-linear) channel through the modern API and dump the raw response.\n    func probeLinear(channelID: String) async {\n        do {\n            let tune = try await json(\"POST\", \"\/playback\/play\/v1\/tuneSource\",\n                                      body: [\"id\": channelID, \"type\": \"channel-linear\", \"hlsVersion\": \"V3\",\n                                             \"manifestVariant\": \"WEB\", \"mtcVersion\": \"V2\"],\n                                      bearer: try await bearer())\n            let data = try JSONSerialization.data(withJSONObject: tune, options: [.prettyPrinted, .withoutEscapingSlashes])\n            try data.write(to: URL(fileURLWithPath: \"\/tmp\/spx-linear-probe.json\"))\n        } catch {\n            try? \"\\(error)\".write(toFile: \"\/tmp\/spx-linear-probe.json\", atomically: true, encoding: .utf8)\n        }\n    }\n\n    \/\/\/ The track an Xtra channel would start with if tuned now, without downloading anything."},"spilled":1793644927.6364841}