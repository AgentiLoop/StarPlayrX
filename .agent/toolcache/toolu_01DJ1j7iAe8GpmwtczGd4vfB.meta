{"tool":"user_shell","input":{"command":"mkdir -p \/tmp\/lbl; rm -f \/tmp\/lbl\/*; S() { perl -e 'alarm 40; exec @ARGV' -- osascript -e \"tell application \\\"StarPlayrX\\\" to $1\"; }\nxs=(-300 -230 -160)\nfor n in 1 2 3; do\n  S 'show menu' >\/dev\/null; sleep 0.4\n  \/tmp\/c ${xs[$n]} 140; sleep 0.65\n  \/tmp\/wins 9095 > \/tmp\/lbl\/w$n.txt\n  P=$(awk '$1==101{print $2}' \/tmp\/lbl\/w$n.txt | head -1); M=$(awk '$1==3{print $2}' \/tmp\/lbl\/w$n.txt | head -1)\n  screencapture -x -o -l $M \/tmp\/lbl\/panel$n.png; [ -n \"$P\" ] && screencapture -x -o -l $P \/tmp\/lbl\/pop$n.png\n  echo \"$n stage=$(defaults read com.starplayrx.mac bubbleStage) shaded=$(S 'get menu shaded')\"; cat \/tmp\/lbl\/w$n.txt\n  sleep 2.5\ndone; ls \/tmp\/lbl"},"spilled":1793633236.223793}