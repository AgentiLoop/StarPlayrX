{"spilled":1793567875.180999,"tool":"file","input":{"file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrRadioKit\/Sources\/StarPlayrRadioKit\/Routes\/playlistRoute.swift","source":"                    \/\/MARK: fix duration\n                    playlist = playlist.replacingOccurrences(of: \"#EXT-X-TARGETDURATION:10\", with: \"#EXT-X-TARGETDURATION:9\")\n                    \n                    \/\/MARK: this keeps the PDT in sync, go figure\n                    playlist = playlist.replacingOccurrences(of: \"#EXTINF:10,\", with: \"#EXTINF:1,\")\n","action":"diff_apply","destination":"                    \/\/ The Mac app needs true durations so the player's date matches the stream's PDT.\n                    if realSegmentDurations { return playlist }\n\n                    \/\/MARK: fix duration\n                    playlist = playlist.replacingOccurrences(of: \"#EXT-X-TARGETDURATION:10\", with: \"#EXT-X-TARGETDURATION:9\")\n                    \n                    \/\/MARK: this keeps the PDT in sync, go figure\n                    playlist = playlist.replacingOccurrences(of: \"#EXTINF:10,\", with: \"#EXTINF:1,\")\n"}}