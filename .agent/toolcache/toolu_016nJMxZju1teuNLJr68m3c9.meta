{"spilled":1793633236.1280432,"input":{"action":"diff_apply","file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrRadioKit\/Sources\/StarPlayrRadioKit\/API\/Data.swift","start_line":20,"destination":"    \/\/ A segment that takes longer than this is useless to the player anyway; fail fast so it can retry.\n    urlReq.timeoutInterval = TimeInterval(8)\n    urlReq.cachePolicy = .reloadIgnoringLocalAndRemoteCacheData\n    \n    let task = URLSession.shared.dataTask(with: urlReq ) { ( data, response, _ ) in\n        \/\/ Always release the waiting server thread, or a failed download hangs that request forever.\n        defer { semaphore.signal() }\n        \n        guard\n            let d = data,\n            (response as? HTTPURLResponse)?.statusCode ?? 200 < 400\n        else { DataHandler(.none); return\n        }\n        \n        DataHandler(d)\n    }\n    \n    task.resume()\n    _ = semaphore.wait(timeout: .now() + 10)","end_line":36},"tool":"file"}