{"input":{"action":"diff_apply","start_line":236,"destination":"\/\/\/ A couple of small, round bubbles rising through a bar, half a cycle apart (some bars get just one).\n\/\/\/ Each is a crisp disc with a little highlight, swaying gently and fading in at the bottom and out at the top.\nprivate struct LavaBubbles: View {\n    let rise: Double\n    let seed: Double\n    let color: Color\n\n    var body: some View {\n        Canvas { ctx, size in\n            guard size.height > 8 else { return }\n            for k in 0..<2 {\n                \/\/ Every third bar gets one bubble only, so the row isn't uniformly busy.\n                if k == 1, Int(seed) % 3 == 0 { continue }\n                let p = (rise + Double(k) \/ 2 + seed * 0.137).truncatingRemainder(dividingBy: 1)\n                let d = min(size.width * 0.55, size.height * 0.3)             \/\/ small and perfectly round\n                let x = size.width \/ 2 + size.width * 0.1 * sin(p * 6 + seed * 2)\n                let y = size.height + d \/ 2 - (size.height + d) * p           \/\/ in from the bottom, out the top\n                let fade = min(1, sin(p * .pi) * 2)\n                let rect = CGRect(x: x - d \/ 2, y: y - d \/ 2, width: d, height: d)\n                ctx.fill(Path(ellipseIn: rect), with: .color(color.opacity(0.35 * fade)))\n                \/\/ A small highlight up and to the left makes it read as a round bubble, not a smudge.\n                let hl = CGRect(x: rect.minX + d * 0.22, y: rect.minY + d * 0.18, width: d * 0.3, height: d * 0.3)\n                ctx.fill(Path(ellipseIn: hl), with: .color(.white.opacity(0.5 * fade)))\n            }\n        }\n        .allowsHitTesting(false)\n    }\n}","file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Visualizer.swift","end_line":258},"spilled":1793633236.1689439,"tool":"file"}