{"input":{"command":"cd \/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources && python3 - <<'E'\np='SpectrumTimeline.swift'; s=open(p).read()\na=\"\"\"            \/\/ Log-spaced bands from bin 2 (~90 Hz) up to Nyquist.\n            let count = Visualizer.bandCount\n            return (0..<count).map { b in\n                let lo = Int(2 * pow(Float(half \/ 2), Float(b) \/ Float(count)))\n                let hi = max(lo + 1, min(half, Int(2 * pow(Float(half \/ 2), Float(b + 1) \/ Float(count)))))\"\"\"\nb=\"\"\"            \/\/ Log-spaced bands from bin 2 (~90 Hz) up to ~16 kHz (bin 372 at 44.1 kHz). The AAC\n            \/\/ encoder cuts off most content above that, so a band reaching Nyquist never moved.\n            let count = Visualizer.bandCount\n            let top: Float = 372\n            return (0..<count).map { b in\n                let lo = Int(2 * pow(top \/ 2, Float(b) \/ Float(count)))\n                let hi = max(lo + 1, min(half, Int(2 * pow(top \/ 2, Float(b + 1) \/ Float(count)))))\"\"\"\nassert a in s; open(p,'w').write(s.replace(a,b))\nE\ngrep -n \"top\" SpectrumTimeline.swift"},"spilled":1793633236.136445,"tool":"user_shell"}