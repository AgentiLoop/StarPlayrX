{"input":{"command":"S() { perl -e 'alarm 40; exec @ARGV' -- osascript -e \"tell application \\\"StarPlayrX\\\" to $1\"; }\nS 'drag menu {-500, 200}' 2>&1; sleep 1.5; S 'get {menu detached, menu position}'; W=$(\/tmp\/wid $(pgrep -f \"Debug\/StarPlayrX.app\") | head -1 | cut -d' ' -f1); screencapture -x -o -l $W \/tmp\/spx-shots\/StarPlayrX-Mac-tear-off.png\nS 'toggle shade' >\/dev\/null; sleep 1.2; screencapture -x -o -l $W \/tmp\/spx-shots\/StarPlayrX-Mac-shade.png; S 'toggle shade' >\/dev\/null\nsips -g pixelHeight \/tmp\/spx-shots\/*.png | grep -v \"^$\""},"spilled":1793633236.2097058,"tool":"user_shell"}