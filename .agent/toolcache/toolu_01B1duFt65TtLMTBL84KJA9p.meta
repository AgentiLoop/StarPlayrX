{"tool":"file","input":{"start_line":193,"file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Visualizer.swift","end_line":204,"destination":"                \/\/ A glow in the bar's own colour washes out on a light panel; there it's the darkest shade\n                \/\/ of the bar's hue instead, and stronger, so the bars stand off the background.\n                let light = bg >= 0.5\n                let glow = light ? ContrastColor.color(hue: hue(h + 0.06 + 0.1 * level), saturation: 0.9, against: bg, minRatio: 14) : top\n                RoundedRectangle(cornerRadius: 1.5)\n                    .fill(LinearGradient(colors: [base, top], startPoint: .bottom, endPoint: .top))\n                    \/\/ On a light panel a thin dark edge keeps pale bars from melting into it.\n                    .overlay {\n                        if light {\n                            RoundedRectangle(cornerRadius: 1.5).strokeBorder(.black.opacity(0.25), lineWidth: 0.5)\n                        }\n                    }\n                    .frame(height: max(2, CGFloat(level) * 28))\n                    .shadow(color: glow.opacity(light ? 0.75 + 0.25 * viz.pulse : 0.4 + 0.6 * viz.pulse), radius: 1 + 4 * viz.pulse)","action":"diff_apply"},"spilled":1793633236.1563621}