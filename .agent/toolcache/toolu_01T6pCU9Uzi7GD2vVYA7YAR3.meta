{"input":{"old_string":"                let wobble = 0.14 * sin(p * 2 * .pi * (1.5 + hash(2)) + Double(k))\n                let w = d * (1 - wobble), h = d * (1 + wobble)\n                let x = size.width \/ 2 + size.width * 0.12 * sin(p * (4 + 3 * hash(3)) + seed * 2 + Double(k))\n                let y = size.height + h \/ 2 - (size.height + h) * p           \/\/ in from the bottom, out the top\n                let fade = min(1, sin(p * .pi) * 2)\n                let rect = CGRect(x: x - w \/ 2, y: y - h \/ 2, width: w, height: h)","file_path":"\/Users\/toddbruss\/Documents\/GitHub\/StarPlayrX\/StarPlayrXMac\/Sources\/Visualizer.swift","new_string":"                \/\/ Only a slight stretch and squash, so they stay round.\n                let wobble = 0.06 * sin(p * 2 * .pi * (1.5 + hash(2)) + Double(k))\n                let w = d * (1 - wobble), h = d * (1 + wobble)\n                let x = size.width \/ 2 + size.width * 0.12 * sin(p * (4 + 3 * hash(3)) + seed * 2 + Double(k))\n                let y = size.height + h \/ 2 - (size.height + h) * p           \/\/ in from the bottom, out the top\n                let fade = min(1, sin(p * .pi) * 2)\n                let rect = CGRect(x: x - w \/ 2, y: y - h \/ 2, width: w, height: h)\n                \/\/ About a third of the bubbles cast a soft shadow down and right, another third glow.\n                let look = hash(4)\n                if look < 0.33 {\n                    let shadow = rect.offsetBy(dx: w * 0.12, dy: h * 0.15).insetBy(dx: -w * 0.05, dy: -h * 0.05)\n                    ctx.fill(Path(ellipseIn: shadow), with: .radialGradient(\n                        Gradient(colors: [Color.black.opacity(0.28 * fade), Color.black.opacity(0)]),\n                        center: CGPoint(x: shadow.midX, y: shadow.midY), startRadius: 0, endRadius: max(w, h) * 0.6))\n                } else if look > 0.67 {\n                    let halo = rect.insetBy(dx: -w * 0.4, dy: -h * 0.4)\n                    ctx.fill(Path(ellipseIn: halo), with: .radialGradient(\n                        Gradient(colors: [Color.white.opacity(0.22 * fade), Color.white.opacity(0)]),\n                        center: CGPoint(x: halo.midX, y: halo.midY), startRadius: 0, endRadius: max(halo.width, halo.height) * 0.5))\n                }","action":"edit"},"spilled":1793581669.35818,"tool":"edit_file"}