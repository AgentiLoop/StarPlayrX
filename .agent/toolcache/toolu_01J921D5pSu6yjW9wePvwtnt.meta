{"tool":"user_shell","spilled":1793633236.236151,"input":{"command":"m() { osascript -e \"tell application \\\"Safari\\\" to do JavaScript \\\"var e=document.querySelectorAll('.glow')[$1]; window.scrollTo({top: e.getBoundingClientRect().top + scrollY - 150, behavior: 'instant'}); var q=e.getBoundingClientRect(); [Math.round(q.left), Math.round(q.width), Math.round(q.height)].join(',')\\\" in document 1\"; }\nfor k in 1 2 3 4; do osascript -e 'tell application \"Safari\" to do JavaScript \"window.scrollTo({top: 0, behavior: \\\"instant\\\"})\" in document 1' >\/dev\/null; sleep 0.5; info=$(m 3); for s in 0.3 1.5 3; do sleep $s; IFS=, read l w h <<< \"$info\"; screencapture -x -R$l,270,$w,$h \/tmp\/glow.png; echo \"run$k +$s: $(\/tmp\/b | awk '{print $9}')\"; done; done"}}